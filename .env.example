# Copier ce fichier en `.env` avant `docker compose up` : DB_PASSWORD n'a pas de valeur
# par défaut, la pile refuse de démarrer sans lui (§8 - aucun secret dans le code).

# --- Base de données (obligatoire) ---
DB_NAME=smartflow
DB_USER=smartflow
DB_PASSWORD=change-me

# --- Module IA (§12.2) ---
# Désactivé par défaut : sans cette variable, le back-end n'appelle jamais le service IA et
# l'application reste pleinement utilisable (AiClient refuse l'appel plutôt que de le tenter).
AI_ENABLED=false

# --- Journalisation (§15.3) ---
# Niveaux ajustables sans reconstruire l'image. LOG_LEVEL ne concerne que le code SmartFlow,
# LOG_LEVEL_ROOT tout le reste. SHOW_SQL=true rejoue chaque requête SQL dans les logs.
LOG_LEVEL=INFO
LOG_LEVEL_ROOT=INFO
SHOW_SQL=false
